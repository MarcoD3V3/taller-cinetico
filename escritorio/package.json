{
  "name": "taller-cinetico-escritorio",
  "productName": "Taller Cinético",
  "version": "1.0.1",
  "description": "Taller Cinético para escritorio",
  "main": "main.js",
  "author": "MarcoD3V3",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "store": "electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.marcod3v3.tallercinetico",
    "productName": "Taller Cinético",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "splash.html", "titlebar.html", "build/icon.png", "build/taller-pixel.woff"],
    "extraResources": [
      { "from": "../index.html", "to": "game/index.html" },
      { "from": "../css", "to": "game/css" },
      { "from": "../js", "to": "game/js" },
      { "from": "../sprites", "to": "game/sprites" }
    ],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Taller Cinético", "artifactName": "TallerCinetico-Instalador.exe" },
    "portable": { "artifactName": "TallerCinetico-Portable.exe" },
    "appx": {
      "identityName": "PON.AQUI.EL.NOMBRE.DE.PAQUETE",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "MarcoD3V3",
      "displayName": "Taller Cinético",
      "applicationId": "TallerCinetico",
      "backgroundColor": "#121315",
      "languages": ["es-ES", "en-US"],
      "artifactName": "TallerCinetico-Store.appx"
    }
  }
}
